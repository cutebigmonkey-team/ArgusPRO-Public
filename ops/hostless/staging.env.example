# Copy outside the checkout or bind through the staging secret manager.
# Use an isolated staging project and staging-only resources.
ARGUS_COLLECTOR_RUNTIME=hostless
ARGUS_RUNTIME_MODE=preflight
ARGUS_ARCHIVE_WRITER_OWNER=
ARGUS_DRIVE_OAUTH=
ARGUS_DRIVE_FOLDER_ID=
DATABASE_URL=
ARGUS_DATABASE_SESSION_URL=
ARGUS_JSONBIN_BIN_ID=
ARGUS_JSONBIN_KEY=
ARGUS_JSONBIN_KEY_TYPE=access
ARGUS_MIN_PRIVATE_SOURCES=
# Leave blank to read sources.json from the staging Drive root.
ARGUS_PRIVATE_SOURCE_FILE=
# Audit runner only. A dedicated read-only staging role.
ARGUS_AUDIT_DATABASE_URL=
